@using StajYonetimSistemi.Models
@using StajYonetimSistemi.ViewModels
@model BelgelerimViewModel

@* sayfanın sekmede görünen başlığı *@
@{
    ViewData["Title"] = "Belgelerim";
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

@functions {
    // durum rozetinin rengi; renk tek başına anlam taşımasın diye rozetin içinde yazı da var
    static string Rozet(DocumentStatus durum) => durum switch
    {
        DocumentStatus.Inceleniyor => "text-bg-warning",
        DocumentStatus.HataliEksik => "text-bg-danger",
        DocumentStatus.Onaylandi => "text-bg-info",
        DocumentStatus.Tamamlandi => "text-bg-success",
        _ => "text-bg-secondary"
    };

    // rapor satırının başına işaret: geçerli ✓, bilgi ℹ, hata ✗ (renge ek olarak işaret ve yazı var)
    static (string Isaret, string Sinif) Isaretle(string satir)
    {
        if (satir.EndsWith("geçerli")) { return ("✓", "text-success"); }
        if (satir.Contains("okunamadi") || satir.Contains("desteklenmiyor")) { return ("ℹ", "text-muted"); }
        return ("✗", "text-danger");
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3 belir">
    <div>
        <h1 class="h3 mb-1">Belgelerim</h1>
        <p class="text-muted mb-0">Yüklediğin belgeler ve kontrol sonuçları.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Documents" asp-action="Upload">Belge Yükle</a>
</div>

@* silme sonrası controller'ın bıraktığı mesaj: silindiyse "Başarılı", silinemediyse "Uyarı"; renge ek olarak yazı da var *@
@if (TempData["Mesaj"] is string mesaj)
{
    var silindi = mesaj == "Belge silindi.";
    <div class="alert @(silindi ? "alert-success" : "alert-warning")" role="status">
        <strong>@(silindi ? "Başarılı:" : "Uyarı:")</strong> @mesaj
    </div>
}

<div class="card shadow-sm belir belir-1">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <caption class="visually-hidden">Yüklediğin belgelerin dosya, tarih, durum, kontrol sonucu ve işlem listesi</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Dosya</th>
                    <th scope="col">Yükleme tarihi</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Kontrol sonucu</th>
                    <th scope="col">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Belgeler.Any())
                {
                    foreach (var belge in Model.Belgeler)
                    {
                        <tr>
                            <td class="text-break">@belge.DosyaAdi</td>
                            <td>@belge.YuklemeTarihi.ToString("g", tr)</td>
                            <td><span class="badge @Rozet(belge.Durum)">@belge.DurumMetni</span></td>
                            <td>
                                @if (!belge.RaporSatirlari.Any())
                                {
                                    <span class="text-muted">Rapor yok</span>
                                }
                                else
                                {
                                    <details>
                                        <summary>Sonucu göster</summary>
                                        <ul class="list-unstyled small mt-2 mb-0">
                                            @foreach (var satir in belge.RaporSatirlari)
                                            {
                                                var isaret = Isaretle(satir);
                                                <li><span class="@isaret.Sinif" aria-hidden="true">@isaret.Isaret</span> @satir</li>
                                            }
                                        </ul>
                                        @if (belge.Durum == DocumentStatus.HataliEksik)
                                        {
                                            <p class="small text-muted mt-2 mb-0">Belgeni düzeltip yeniden yükleyebilirsin.</p>
                                        }
                                    </details>
                                }
                            </td>
                            <td>
                                @if (belge.Durum == DocumentStatus.Tamamlandi)
                                {
                                    @* tamamlanmış belge silinemez: buton gizlenmez, soluk gösterilir ve nedeni yazılır *@
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Sil</button>
                                    <div class="small text-muted mt-1">Tamamlandı, silinemez</div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            data-bs-toggle="modal" data-bs-target="#silModal"
                                            data-belge-id="@belge.Id" data-belge-ad="@belge.DosyaAdi">Sil</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    @* hiç belge yoksa sakin bir açıklama ve yükleme yolu gösterilir *@
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Henüz belge yüklemedin. Başlamak için "Belge Yükle" butonuna bas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* silme onayı: geri alınamayan işlem olduğu için bir kez sorulur; tek pencere, bilgiler tıklanan satırdan gelir *@
<div class="modal fade" id="silModal" tabindex="-1" aria-labelledby="silBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Documents" asp-action="Sil">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="silBaslik">Belgeyi sil</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="silBelgeId" />
                    <p class="mb-1"><strong id="silBelgeAd"></strong> belgesi silinecek.</p>
                    <p class="text-muted small mb-0">Bu işlem geri alınamaz.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-danger">Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // modal açılırken, tıklanan satırın belge numarası ve adı pencereye yazılır
        var silModal = document.getElementById("silModal");
        silModal.addEventListener("show.bs.modal", function (olay) {
            var dugme = olay.relatedTarget;
            document.getElementById("silBelgeId").value = dugme.getAttribute("data-belge-id");
            document.getElementById("silBelgeAd").textContent = dugme.getAttribute("data-belge-ad");
        });
    </script>
}