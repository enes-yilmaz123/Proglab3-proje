@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="text-center py-4 belir">
    @* süs amaçlı büyük amblem; menüdeki amblem zaten adı söylediği için burada alt metni boş *@
    <img src="~/img/kou-logo.png" alt="" width="110" height="110" class="mb-3" />
    <h1 class="display-5 fw-semibold">Staj Evrak Yönetim Sistemi</h1>
    <p class="lead text-muted col-lg-7 mx-auto">Kocaeli Üniversitesi öğrencileri için Ek-16 staj formu yükleme ve kontrol sistemi.</p>

    <div class="d-flex justify-content-center gap-2 mt-4">
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-primary" asp-controller="Auth" asp-action="Login">Giriş Yap</a>
            <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Register">Kayıt Ol</a>
        }
        else if (User.IsInRole("ROLE_STUDENT"))
        {
            <a class="btn btn-primary" asp-controller="Documents" asp-action="Upload">Belge Yükle</a>
            <a class="btn btn-outline-primary" asp-controller="Documents" asp-action="Index">Belgelerim</a>
        }
        else if (User.IsInRole("ROLE_ADMIN"))
        {
            <a class="btn btn-primary" asp-controller="Admin" asp-action="Index">Yönetim Paneline Git</a>
        }
    </div>
</section>

@* "nasıl çalışır" adımları ve kontrol kapsamı öğrenciler içindir; yönetici için gösterilmez, ekran sade kalır *@
@if (!User.IsInRole("ROLE_ADMIN"))
{
    <section class="row row-cols-1 row-cols-md-3 g-3 mt-2" aria-label="Nasıl çalışır">
        <div class="col belir belir-1">
            <div class="card h-100 adim-karti">
                <div class="card-body">
                    <span class="adim-no" aria-hidden="true">1</span>
                    <h2 class="h5 card-title">Kayıt ol</h2>
                    <p class="card-text text-muted">Öğrenci bilgilerinle hesabını oluştur.</p>
                </div>
            </div>
        </div>
        <div class="col belir belir-2">
            <div class="card h-100 adim-karti">
                <div class="card-body">
                    <span class="adim-no" aria-hidden="true">2</span>
                    <h2 class="h5 card-title">Belgeni yükle</h2>
                    <p class="card-text text-muted">Ek-16 formunu Word, PDF veya resim olarak sisteme yükle.</p>
                </div>
            </div>
        </div>
        <div class="col belir belir-3">
            <div class="card h-100 adim-karti">
                <div class="card-body">
                    <span class="adim-no" aria-hidden="true">3</span>
                    <h2 class="h5 card-title">Sonucu gör</h2>
                    <p class="card-text text-muted">Kontrol sonucunu ve varsa eksikleri incele.</p>
                </div>
            </div>
        </div>
    </section>

    @* sistemin gerçekte neleri kontrol ettiği: Word belgeleri otomatik okunur, diğer biçimler şimdilik elle incelenir *@
    <section class="mt-4 belir belir-3" aria-labelledby="kapsamBaslik">
        <h2 class="h4 mb-3" id="kapsamBaslik">Neler kontrol edilir?</h2>
        <div class="card">
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-5">
                        <h3 class="h6 fw-semibold">Her belgede</h3>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-1"><span class="text-success fw-bold me-2" aria-hidden="true">✓</span>Dosya biçimi: Word, PDF, JPEG ya da PNG olmalı</li>
                        </ul>
                    </div>
                    <div class="col-md-7">
                        <h3 class="h6 fw-semibold">Word (.docx) belgelerinde otomatik</h3>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-1"><span class="text-success fw-bold me-2" aria-hidden="true">✓</span>Kimlik numarası: 11 haneli ve rakam, T.C. için ilk hane 0 değil, yabancı için 99 ile başlıyor</li>
                            <li class="mb-1"><span class="text-success fw-bold me-2" aria-hidden="true">✓</span>Telefon numarası: +90 xxx xxx xx xx biçiminde</li>
                            <li class="mb-1"><span class="text-success fw-bold me-2" aria-hidden="true">✓</span>E-posta adresi: geçerli biçimde</li>
                            <li class="mb-1"><span class="text-success fw-bold me-2" aria-hidden="true">✓</span>Ad soyad, öğrenci numarası ve e-posta: hesabındaki bilgilerle aynı</li>
                        </ul>
                    </div>
                </div>
                <p class="small text-muted mt-3 mb-0">Eski Word (.doc), PDF ve resim belgeleri şimdilik otomatik okunmaz, yönetici tarafından incelenir. Durumu "İnceleniyor" olarak görünür.</p>
            </div>
        </div>
    </section>
}