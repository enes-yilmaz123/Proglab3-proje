@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center">
    <h1 class="display-4">KOÜ Staj Sistemi'ne Hoş Geldiniz</h1>
    <p class="lead">Staj evrakınızı (Ek-16) yükleyin, kontrol sonuçlarını görün.</p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-primary me-2" asp-controller="Auth" asp-action="Login">Giriş Yap</a>
        <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Register">Kayıt Ol</a>
    }
    else if (User.IsInRole("ROLE_STUDENT"))
    {
        <a class="btn btn-primary" asp-controller="Documents" asp-action="Upload">Belge Yükle</a>
    }
</div>