@using StajYonetimSistemi.Models
@using StajYonetimSistemi.ViewModels
@model BasvurularViewModel

@* sayfanın sekmede görünen başlığı *@
@{
    ViewData["Title"] = "Başvurular";
    var tr = new System.Globalization.CultureInfo("tr-TR");

    // sekmeler: "Tümü" için durum boş bırakılır
    var sekmeler = new (string Ad, DocumentStatus? Durum)[]
    {
        ("Tümü", null),
        ("Yüklendi", DocumentStatus.Yuklendi),
        ("İnceleniyor", DocumentStatus.Inceleniyor),
        ("Hatalı / Eksik", DocumentStatus.HataliEksik),
        ("Onaylandı", DocumentStatus.Onaylandi),
        ("Tamamlandı", DocumentStatus.Tamamlandi)
    };

    // durum değiştirme listesindeki seçenekler
    var durumlar = new (string Ad, DocumentStatus Durum)[]
    {
        ("Yüklendi", DocumentStatus.Yuklendi),
        ("İnceleniyor", DocumentStatus.Inceleniyor),
        ("Hatalı / Eksik", DocumentStatus.HataliEksik),
        ("Onaylandı", DocumentStatus.Onaylandi),
        ("Tamamlandı", DocumentStatus.Tamamlandi)
    };
}

@functions {
    // durum rozetinin rengi; renk tek başına anlam taşımasın diye rozetin içinde yazı da var
    static string Rozet(DocumentStatus durum) => durum switch
    {
        DocumentStatus.Inceleniyor => "text-bg-warning",
        DocumentStatus.HataliEksik => "text-bg-danger",
        DocumentStatus.Onaylandi => "text-bg-info",
        DocumentStatus.Tamamlandi => "text-bg-success",
        _ => "text-bg-secondary"
    };

    // rapor yazısını satırlara böler; boş raporda boş liste döner
    static string[] RaporSatirlari(string rapor) =>
        rapor.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // rapor satırının başına işaret: geçerli ✓, bilgi ℹ, hata ✗ (renge ek olarak işaret ve yazı var)
    static (string Isaret, string Sinif) Isaretle(string satir)
    {
        if (satir.EndsWith("geçerli")) { return ("✓", "text-success"); }
        if (satir.Contains("okunamadi") || satir.Contains("desteklenmiyor")) { return ("ℹ", "text-muted"); }
        return ("✗", "text-danger");
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3 belir">
    <div>
        <h1 class="h3 mb-1">Başvurular</h1>
        <p class="text-muted mb-0">Yüklenen staj belgeleri.</p>
    </div>
    <span class="badge text-bg-light border fs-6">@Model.Satirlar.Count belge</span>
</div>

@* duruma göre sekmeler: seçili sekme "active" olur, yazdığın arama sekme değişince de korunur *@
<nav aria-label="Duruma göre filtre" class="mb-3">
    <ul class="nav nav-pills gap-1">
        @foreach (var sekme in sekmeler)
        {
            var aktif = Model.SecilenDurum == sekme.Durum;
            <li class="nav-item">
                <a class="nav-link @(aktif ? "active" : "")"
                   aria-current="@(aktif ? "page" : null)"
                   asp-action="Basvurular"
                   asp-route-durum="@sekme.Durum"
                   asp-route-arama="@Model.Arama">@sekme.Ad</a>
            </li>
        }
    </ul>
</nav>

@* arama: öğrenci adı ya da numarasına göre *@
<form method="get" asp-action="Basvurular" class="row g-2 mb-3" role="search">
    @if (Model.SecilenDurum != null)
    {
        <input type="hidden" name="durum" value="@Model.SecilenDurum" />
    }
    <div class="col-12 col-md-6 col-lg-5">
        <label for="arama" class="visually-hidden">Öğrenci adı ya da numarası</label>
        <input type="search" class="form-control" id="arama" name="arama" value="@Model.Arama" placeholder="Öğrenci adı ya da numarası" />
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary">Ara</button>
        @if (!string.IsNullOrWhiteSpace(Model.Arama))
        {
            <a class="btn btn-outline-secondary" asp-action="Basvurular" asp-route-durum="@Model.SecilenDurum">Aramayı temizle</a>
        }
    </div>
</form>

<div class="card shadow-sm belir belir-1">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Yüklenen belgelerin öğrenci, dosya, tarih, durum, kontrol sonucu ve işlem listesi</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Öğrenci</th>
                    <th scope="col">Dosya</th>
                    @* telefonda yer açmak için yükleme tarihi sütunu yalnızca geniş ekranda görünür *@
                    <th scope="col" class="d-none d-md-table-cell">Yükleme tarihi</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Kontrol sonucu</th>
                    <th scope="col">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Satirlar.Any())
                {
                    foreach (var satir in Model.Satirlar)
                    {
                        var raporSatirlari = RaporSatirlari(satir.Rapor);
                        <tr>
                            <td>
                                @satir.OgrenciAdSoyad
                                <div class="small text-muted">@satir.OgrenciNo</div>
                            </td>
                            <td class="text-break small">@satir.DosyaAdi</td>
                            <td class="d-none d-md-table-cell">@satir.YuklemeTarihi.ToString("g", tr)</td>
                            <td><span class="badge @Rozet(satir.Durum)">@satir.DurumMetni</span></td>
                            <td>
                                @if (raporSatirlari.Length == 0)
                                {
                                    <span class="text-muted">Rapor yok</span>
                                }
                                else
                                {
                                    <details>
                                        <summary>Sonucu göster</summary>
                                        <ul class="list-unstyled small mt-2 mb-0">
                                            @foreach (var rs in raporSatirlari)
                                            {
                                                var isaret = Isaretle(rs);
                                                <li><span class="@isaret.Sinif" aria-hidden="true">@isaret.Isaret</span> @rs</li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </td>
                            <td>
                                @* durum değiştirme: seçili durum şu anki durumdur; "Güncelle" ile kaydedilir; dar ekranda alt satıra geçer *@
                                <form method="post" asp-action="DurumDegistir" class="d-flex flex-wrap gap-1 mb-1">
                                    <input type="hidden" name="id" value="@satir.Id" />
                                    <label for="durum-@satir.Id" class="visually-hidden">@satir.DosyaAdi için yeni durum</label>
                                    <select class="form-select form-select-sm" id="durum-@satir.Id" name="yeniDurum">
                                        @foreach (var d in durumlar)
                                        {
                                            <option value="@d.Durum" selected="@(d.Durum == satir.Durum)">@d.Ad</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Güncelle</button>
                                </form>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#silModal"
                                        data-belge-id="@satir.Id" data-belge-ad="@satir.DosyaAdi">Sil</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    @* boş liste: belge simgesi ve neden boş olduğu yazar *@
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <svg class="mb-2" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg>
                            <br />
                            @if (!string.IsNullOrWhiteSpace(Model.Arama))
                            {
                                <text>"@Model.Arama" için sonuç bulunamadı. Başka bir ad ya da numara dene.</text>
                            }
                            else
                            {
                                <text>Bu durumda belge yok.</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Yönetim Paneli</a>
</div>

@* silme onayı: geri alınamayan işlem olduğu için bir kez sorulur; tek pencere, bilgiler tıklanan satırdan gelir *@
<div class="modal fade" id="silModal" tabindex="-1" aria-labelledby="silBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Sil">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="silBaslik">Belgeyi sil</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="silBelgeId" />
                    <p class="mb-1"><strong id="silBelgeAd"></strong> belgesi silinecek.</p>
                    <p class="text-muted small mb-0">Bu işlem geri alınamaz.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-danger">Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // modal açılırken, tıklanan satırın belge numarası ve adı pencereye yazılır
        var silModal = document.getElementById("silModal");
        silModal.addEventListener("show.bs.modal", function (olay) {
            var dugme = olay.relatedTarget;
            document.getElementById("silBelgeId").value = dugme.getAttribute("data-belge-id");
            document.getElementById("silBelgeAd").textContent = dugme.getAttribute("data-belge-ad");
        });
    </script>
}