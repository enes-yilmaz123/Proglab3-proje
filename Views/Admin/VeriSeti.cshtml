@* sayfanın sekmede görünen başlığı *@
@{
    ViewData["Title"] = "Veri Seti";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm kimlik-karti belir">
            <div class="card-body p-4">
                <div class="mb-3">
                    <h1 class="h3 mb-1">Veri Seti</h1>
                    <p class="text-muted mb-0">Kontrol için kullanılan veri setini buradan yükleyeceksin.</p>
                </div>

                <div class="alert alert-light border" role="note">
                    <strong>Bilgi:</strong> Bu özellik henüz hazır değil. Hazır olunca buradan dosya yükleyebileceksin.
                </div>

                @* şimdilik çalışmıyor: gizlenmez, soluk gösterilir *@
                <div class="mb-3">
                    <label for="veriSetiDosya" class="form-label">Veri seti dosyası</label>
                    <input type="file" class="form-control" id="veriSetiDosya" disabled />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" asp-action="Index">Yönetim Paneli</a>
                    <button type="button" class="btn btn-primary" disabled>Yükle</button>
                </div>
            </div>
        </div>
    </div>
</div>
