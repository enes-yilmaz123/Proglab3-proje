@model StajYonetimSistemi.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-sm kimlik-karti belir">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <img class="kimlik-logo mb-2" src="~/img/kou-logo.png" alt="" />
                    <h1 class="h3 mb-1">Giriş Yap</h1>
                    <p class="text-muted mb-0">Hesabınla devam et.</p>
                </div>

                @* controller'ın eklediği genel hatalar (yanlış şifre, kilitli hesap) varsa "Hata" kutusunda göster *@
                @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Hata:</strong>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">E-posta</label>
                        <input asp-for="Email" class="form-control" autofocus autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <div class="input-group">
                            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary sifre-goster" data-hedef="Password" aria-pressed="false">Göster</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Giriş yap</button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-transparent text-center py-3">
                Hesabın yok mu? <a asp-controller="Auth" asp-action="Register">Kayıt ol</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // şifre göster/gizle: kullanıcı yazdığını görebilsin
        document.querySelectorAll(".sifre-goster").forEach(function (dugme) {
            dugme.addEventListener("click", function () {
                var alan = document.getElementById(dugme.dataset.hedef);
                var gizli = alan.type === "password";
                alan.type = gizli ? "text" : "password";
                dugme.textContent = gizli ? "Gizle" : "Göster";
                dugme.setAttribute("aria-pressed", gizli ? "true" : "false");
            });
        });
    </script>
}
