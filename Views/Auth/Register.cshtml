@model StajYonetimSistemi.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4">Kayıt Ol</h2>

        @* controller'ın eklediği genel hata (aynı e-posta ile hesap var) varsa "Hata" kutusunda göster *@
        @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Hata:</strong>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <form asp-controller="Auth" asp-action="Register" method="post">
            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">Ad</label>
                <input asp-for="FirstName" class="form-control" autofocus autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Soyad</label>
                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StudentNumber" class="form-label">Öğrenci Numarası</label>
                <input asp-for="StudentNumber" class="form-control" autocomplete="off" />
                <span asp-validation-for="StudentNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-posta</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Şifre</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" aria-describedby="sifreIpucu" />
                <div id="sifreIpucu" class="form-text">En az 6 karakter olmalı.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrarı</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Kayıt ol</button>
            </div>
        </form>

        <p class="mt-3">Zaten hesabın var mı? <a asp-controller="Auth" asp-action="Login">Giriş yap</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}