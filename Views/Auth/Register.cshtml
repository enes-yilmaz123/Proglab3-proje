@model StajYonetimSistemi.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm kimlik-karti belir">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <img class="kimlik-logo mb-2" src="~/img/kou-logo.png" alt="" />
                    <h1 class="h3 mb-1">Kayıt Ol</h1>
                    <p class="text-muted mb-0">Öğrenci hesabını oluştur.</p>
                </div>

                @* controller'ın eklediği genel hata (aynı e-posta ile hesap var) varsa "Hata" kutusunda göster *@
                @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Hata:</strong>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <form asp-controller="Auth" asp-action="Register" method="post">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">Ad</label>
                            <input asp-for="FirstName" class="form-control" autofocus autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Soyad</label>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StudentNumber" class="form-label">Öğrenci Numarası</label>
                        <input asp-for="StudentNumber" class="form-control" autocomplete="off" />
                        <span asp-validation-for="StudentNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">E-posta</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <div class="input-group">
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" aria-describedby="sifreKurallari" />
                            <button type="button" class="btn btn-outline-secondary sifre-goster" data-hedef="Password" aria-pressed="false">Göster</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <ul class="sifre-kurallari list-unstyled small mt-2 mb-0" id="sifreKurallari">
                            <li data-kural="uzunluk"><span class="isaret" aria-hidden="true">○</span> En az 8 karakter<span class="visually-hidden durum"> (sağlanmadı)</span></li>
                            <li data-kural="buyuk"><span class="isaret" aria-hidden="true">○</span> En az bir büyük harf<span class="visually-hidden durum"> (sağlanmadı)</span></li>
                            <li data-kural="kucuk"><span class="isaret" aria-hidden="true">○</span> En az bir küçük harf<span class="visually-hidden durum"> (sağlanmadı)</span></li>
                            <li data-kural="rakam"><span class="isaret" aria-hidden="true">○</span> En az bir rakam<span class="visually-hidden durum"> (sağlanmadı)</span></li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrarı</label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary sifre-goster" data-hedef="ConfirmPassword" aria-pressed="false">Göster</button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Kayıt ol</button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-transparent text-center py-3">
                Zaten hesabın var mı? <a asp-controller="Auth" asp-action="Login">Giriş yap</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // şifre göster/gizle: kullanıcı yazdığını görebilsin
        document.querySelectorAll(".sifre-goster").forEach(function (dugme) {
            dugme.addEventListener("click", function () {
                var alan = document.getElementById(dugme.dataset.hedef);
                var gizli = alan.type === "password";
                alan.type = gizli ? "text" : "password";
                dugme.textContent = gizli ? "Gizle" : "Göster";
                dugme.setAttribute("aria-pressed", gizli ? "true" : "false");
            });
        });

        // şifre kuralları: yazdıkça işaretlenir (renge ek olarak ✓ işareti ve gizli metin de var)
        var sifre = document.getElementById("Password");
        var kurallar = {
            uzunluk: function (d) { return d.length >= 8; },
            buyuk: function (d) { return /[A-Z]/.test(d); },
            kucuk: function (d) { return /[a-z]/.test(d); },
            rakam: function (d) { return /\d/.test(d); }
        };
        sifre.addEventListener("input", function () {
            document.querySelectorAll("#sifreKurallari li").forEach(function (satir) {
                var tamam = kurallar[satir.dataset.kural](sifre.value);
                satir.classList.toggle("saglandi", tamam);
                satir.querySelector(".isaret").textContent = tamam ? "✓" : "○";
                satir.querySelector(".durum").textContent = tamam ? " (sağlandı)" : " (sağlanmadı)";
            });
        });
    </script>
}