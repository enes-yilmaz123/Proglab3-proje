@{
    // şu an hangi sayfada olunduğunu bulur: menüde o bağlantı kalın yazılır ve ekran okuyucuya "geçerli sayfa" denir
    var kontrol = ViewContext.RouteData.Values["controller"]?.ToString();
    var islem = ViewContext.RouteData.Values["action"]?.ToString();
    bool Burada(string k, string a) => kontrol == k && islem == a;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staj Evrak Yönetim Sistemi</title>
    <link rel="icon" type="image/png" href="~/img/kou-logo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/proglab3_projee.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/kou-logo.png" alt="Kocaeli Üniversitesi amblemi" height="38" style="width:auto" />
                    <span>Staj Evrak Yönetim Sistemi</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menüyü aç veya kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(Burada("Home", "Index") ? "fw-semibold" : "")"
                               aria-current="@(Burada("Home", "Index") ? "page" : null)"
                               asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        @if (User.IsInRole("ROLE_STUDENT"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Burada("Documents", "Upload") ? "fw-semibold" : "")"
                                   aria-current="@(Burada("Documents", "Upload") ? "page" : null)"
                                   asp-controller="Documents" asp-action="Upload">Belge Yükle</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Burada("Documents", "Index") ? "fw-semibold" : "")"
                                   aria-current="@(Burada("Documents", "Index") ? "page" : null)"
                                   asp-controller="Documents" asp-action="Index">Belgelerim</a>
                            </li>
                        }
                        else if (User.IsInRole("ROLE_ADMIN"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Burada("Admin", "Index") ? "fw-semibold" : "")"
                                   aria-current="@(Burada("Admin", "Index") ? "page" : null)"
                                   asp-controller="Admin" asp-action="Index">Yönetim Paneli</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Burada("Admin", "Basvurular") ? "fw-semibold" : "")"
                                   aria-current="@(Burada("Admin", "Basvurular") ? "page" : null)"
                                   asp-controller="Admin" asp-action="Basvurular">Başvurular</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Burada("Students", "Index") ? "fw-semibold" : "")"
                                   aria-current="@(Burada("Students", "Index") ? "page" : null)"
                                   asp-controller="Students" asp-action="Index">Öğrenciler</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(Burada("Admin", "VeriSeti") ? "fw-semibold" : "")"
                                   aria-current="@(Burada("Admin", "VeriSeti") ? "page" : null)"
                                   asp-controller="Admin" asp-action="VeriSeti">Veri Seti</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var eposta = User.Identity.Name ?? "";
                            var harf = eposta.Length > 0 ? eposta.Substring(0, 1).ToUpper(new System.Globalization.CultureInfo("tr-TR")) : "?";
                            var rolYazisi = User.IsInRole("ROLE_ADMIN") ? "Yönetici" : "Öğrenci";

                            @* kullanıcı menüsü: avatarda e-postanın ilk harfi, açılınca e-posta, rol ve kısayollar *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="kullaniciMenusu" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false" aria-label="Kullanıcı menüsü, @eposta">
                                    <span class="kullanici-avatar" aria-hidden="true">@harf</span>
                                    <span class="d-none d-lg-inline">@rolYazisi</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" style="min-width: 15rem;" aria-labelledby="kullaniciMenusu">
                                    <li>
                                        <div class="dropdown-item-text">
                                            <div class="fw-semibold text-break">@eposta</div>
                                            <div class="small text-muted">@rolYazisi</div>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @if (User.IsInRole("ROLE_ADMIN"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Yönetim Paneli</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-controller="Documents" asp-action="Index">Belgelerim</a></li>
                                    }
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Çıkış</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Giriş Yap</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Kayıt Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 - Kocaeli Üniversitesi &middot; Proglab III, 2026-2027 Güz</span>
            <a asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>