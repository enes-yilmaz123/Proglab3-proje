@model ErrorViewModel

@* sayfanın sekmede görünen başlığı *@
@{
    ViewData["Title"] = "Bir sorun oluştu";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm kimlik-karti belir">
            <div class="card-body p-4 text-center">
                <h1 class="h3 mb-2">Bir sorun oluştu</h1>
                <p class="text-muted mb-4">İsteğin işlenirken beklenmedik bir hata çıktı. Biraz sonra tekrar deneyebilirsin.</p>

                @* hata kodu varsa gösterilir; destek isterken kodu söylemek işi kolaylaştırır *@
                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        <strong>Hata kodu:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <div class="d-flex justify-content-center gap-2">
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
                </div>
            </div>
        </div>
    </div>
</div>